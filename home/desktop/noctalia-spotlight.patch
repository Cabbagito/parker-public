+bool LauncherPanel::spotlightEnabled() const {
+  // App-grid layouts keep the fixed card; spotlight is a list-mode look.
+  return m_config != nullptr && m_config->config().shell.launcher.spotlight
+      && !m_config->config().shell.launcher.appGrid;
+}
+
+float LauncherPanel::contentHeightHint() const {
+  if (!spotlightEnabled()) {
+    return 0.0f;
+  }
+  const float scale = contentScale();
+  const float inputH = Style::controlHeight * scale;
+  const float gap = Style::spaceSm * scale;
+  float hint = inputH;
+  if (m_categoryFilter != nullptr && m_categoryFilter->participatesInLayout()) {
+    hint += gap + Style::controlHeightSm * scale;
+  }
+  if (m_results.empty()) {
+    if (!m_query.empty()) {
+      // "no results" label row.
+      hint += gap + Style::fontSizeBody * scale * 2.5f;
+    }
+    return hint;
+  }
+  if (shouldUseDetailPresentation()) {
+    // Calculator/detail card: one roomy block below the input.
+    return hint + gap + 170.0f * scale;
+  }
+  float rowH = m_launcherRowHeight;
+  if (rowH <= 0.0f) {
+    rowH = launcherRowHeightEstimate(launcherListStyleFrom(m_config, scale, panelCardOpacity()));
+  }
+  constexpr std::size_t kMaxSpotlightRows = 10;
+  const auto rows = static_cast<float>(std::min(m_results.size(), kMaxSpotlightRows));
+  return hint + gap + rows * rowH + Style::spaceSm * scale;
+}
