+  std::vector<app_identity::ResolvedRunningApp>
+  dockResolvedRunningApps(const DockConfig& cfg, const CompositorPlatform& platform, wl_output* outputFilter) {
+    if (!cfg.showRunning) {
+      return {};
+    }
+    auto resolved = app_identity::resolveRunningApps(platform.runningAppIds(outputFilter), desktopEntries());
+    if (cfg.exclude.empty()) {
+      return resolved;
+    }
+    // Match on the raw compositor app id as well as the entry it resolved to:
+    // a background window with no desktop file is named by its app id, one
+    // with a desktop file is more naturally named by that entry's id.
+    std::erase_if(resolved, [&cfg](const app_identity::ResolvedRunningApp& run) {
+      const std::string entryIdLower = StringUtils::toLower(run.entry.id);
+      return std::ranges::any_of(cfg.exclude, [&](const std::string& pattern) {
+        const std::string patternLower = StringUtils::toLower(pattern);
+        return !patternLower.empty() && (patternLower == run.runningLower || patternLower == entryIdLower);
+      });
+    });
+    return resolved;
+  }
