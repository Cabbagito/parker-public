simplified_ui false
pane_frames false

layout {
    default_tab_template {
        pane size=1 borderless=false {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}#[fg=black]{tabs}"
                format_center ""
                format_right  "#[fg=#ea2e93,bold] 󰩖 {datetime}#[fg=#4a96ba] "
                format_space  "#[fg=yellow] "
                hide_frame_for_single_pane "false"
                border_enabled  "false"
                mode_normal  "#[fg=blue]   "
                mode_locked  "#[fg=red]   "
                mode_tmux    "#[fg=cyan]   "
				mode_tab     "#[fg=magenta]   "
                mode_session "#[fg=red]   "
                mode_scroll  "#[fg=cyan]   "

                tab_normal              "#[fg=#6C7086]{name}"
                tab_normal_fullscreen   "#[fg=#6C7086]{name}"
                tab_normal_sync         "#[fg=#6C7086]{name}"

                tab_active              "#[fg=blue,bold]{name}#[fg=yellow,bold]{floating_indicator}"
                tab_active_fullscreen   "#[fg=yellow,bold]{name}#[fg=yellow,bold]{fullscreen_indicator}"
                tab_active_sync         "#[fg=green,bold]{name}#[fg=yellow,bold]{sync_indicator}"

                tab_separator           "#[fg=cyan,bold] ⋮ "

                tab_sync_indicator       " "
                tab_fullscreen_indicator " "
                tab_floating_indicator   ""

                datetime        "#[fg=#d668e2,bold] {format} "
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "Europe/Paris"
            }
        }
        children
    }
    tab name=" zsh" focus=true borderless=true {
		pane {
			command "zsh"
			args "-c" "fastfetch; exec zsh"
		}
    }
    tab name="󰨈 claude-1" borderless=true {
		pane {
			command "zsh"
			args "-c" "cd Documents && claude; zsh"
		}
    }
    tab name="󰨈 claude-2" borderless=true {
		pane {
			command "zsh"
			args "-c" "cd Documents && claude; zsh"
		}
    }
    tab name="󰨈 claude-3" borderless=true {
		pane {
			command "zsh"
			args "-c" "cd Documents && claude; zsh"
		}
    }
    tab name="󰨈 claude-4" borderless=true {
		pane {
			command "zsh"
			args "-c" "cd Documents && claude; zsh"
		}
    }
    tab name="󰨈 claude-5" borderless=true {
		pane {
			command "zsh"
			args "-c" "cd Documents && claude; zsh"
		}
    }
}
keybinds {
    shared {
        bind "Alt 1" { NewTab; }
        bind "Alt 2" { GoToNextTab; }
        bind "Alt 3" { CloseTab; }
    }
}